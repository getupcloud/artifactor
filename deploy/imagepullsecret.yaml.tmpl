# Template for the imagePullSecret applied by `artifactor install
# --image-token-env` (reads the token from the given environment variable,
# default REGISTRY_TOKEN). Not processed by plain `kubectl apply -f deploy/`
# because of the .tmpl extension; the placeholder below is replaced at
# install time with the real docker config JSON (base64).
apiVersion: v1
kind: Secret
metadata:
  name: docker-ghcr
  namespace: artifactor
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: __TOKEN_BASE64__
